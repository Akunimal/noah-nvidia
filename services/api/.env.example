PORT=8000
NOAH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOAH_REQUIRE_AUTH=false
NOAH_DEMO_TOKEN=demo-owner
NOAH_DEMO_AUTH=true
# Bounded unauthenticated synthetic sandbox for the public Render video/demo.
# Keep false for a private deployment.
NOAH_PUBLIC_DEMO=false
NOAH_ALLOW_SYNTHETIC_TENANTS=true

# Public demo release policy. Keep synthetic until the scheduled window, then
# allow only bounded Nebius/NVIDIA calls. Set mode=nebius only for an explicit
# operator override; never put an API key in the frontend.
NOAH_PUBLIC_AI_MODE=synthetic
NOAH_PUBLIC_AI_OPEN_AT=2026-10-27T17:00:00Z
NOAH_PUBLIC_AI_DEADLINE_AT=2026-10-30T17:00:00Z
NOAH_PUBLIC_MODEL_USAGE_LIMIT=20
NOAH_PUBLIC_BYOK_USAGE_LIMIT=5
NOAH_JWT_SECRET=

# Preferred hackathon route: Nebius Token Factory
NOAH_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NOAH_NEBIUS_API_KEY=
NOAH_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional free NVIDIA Nemotron route through a user-supplied OpenCode2API gateway.
# The model must remain in the NVIDIA Nemotron family; keep this route
# synthetic-only and never send customer/private data.
NOAH_OPENCODE2API_BASE_URL=
NOAH_OPENCODE2API_KEY=
NOAH_OPENCODE2API_MODEL=nemotron-3-ultra-free
NOAH_ALLOW_FREE_SYNTHETIC=true
NOAH_ENABLE_EXTERNAL_EFFECTS=false
NOAH_ALLOWED_RECIPIENTS=
NOAH_MODEL_USAGE_LIMIT=0

# NVIDIA NIM configuration used by the knowledge pipeline when enabled.
NOAH_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NOAH_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NOAH_NVIDIA_NIM_API_KEY=

# Durable persistence (server only; never expose the database URL to Vite).
NOAH_DATABASE_URL=
NOAH_CONNECTION_ENCRYPTION_KEY=

# Google OAuth Authorization Code + PKCE (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/connections/google/callback

# Optional NVIDIA retrieval adapters.
NOAH_RERANKING_BASE_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
NOAH_RERANKING_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2
NOAH_PARSE_BASE_URL=
NOAH_PARSE_MODEL=nvidia/nemotron-parse
