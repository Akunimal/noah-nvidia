PORT=8000
NOAH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NOAH_REQUIRE_AUTH=false
NOAH_DEMO_TOKEN=demo-owner

# Preferred hackathon route: Nebius Token Factory
NOAH_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NOAH_NEBIUS_API_KEY=
NOAH_NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional free NVIDIA Nemotron route through a user-supplied OpenCode2API gateway.
# Keep this route synthetic-only and never send customer/private data.
NOAH_OPENCODE2API_BASE_URL=
NOAH_OPENCODE2API_KEY=
NOAH_OPENCODE2API_MODEL=nemotron-3-ultra-free
NOAH_ALLOW_FREE_SYNTHETIC=true

# NVIDIA NIM configuration used by the knowledge pipeline when enabled.
NOAH_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NOAH_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NOAH_NVIDIA_NIM_API_KEY=
